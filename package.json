{
  "name": "neuroimage",
  "version": "1.0.0",
  "private": true,
  "description": "Intracranial imaging and anatomy atlas for 2D and 3D browsing",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@niivue/niivue": "0.69.0",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "fflate": "0.8.3"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "npm run typecheck && node node_modules/vite/bin/vite.js build",
    "test": "node node_modules/vitest/vitest.mjs run web/src",
    "prebuild": "node scripts/third_party_notices.mjs"
  }
}
