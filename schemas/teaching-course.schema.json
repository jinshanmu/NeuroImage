{
  "$defs": {
    "CourseEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Prompt",
          "type": "string"
        },
        "scene": {
          "additionalProperties": true,
          "title": "Scene",
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "scene"
      ],
      "title": "CourseEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "neuroimage-teaching-course",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "author": {
      "default": "",
      "maxLength": 200,
      "title": "Author",
      "type": "string"
    },
    "objective": {
      "default": "",
      "maxLength": 4000,
      "title": "Objective",
      "type": "string"
    },
    "created_utc": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Created Utc",
      "type": "string"
    },
    "updated_utc": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Updated Utc",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CourseEntry"
      },
      "maxItems": 100,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "title",
    "created_utc",
    "updated_utc",
    "entries"
  ],
  "title": "TeachingCourse",
  "type": "object"
}
